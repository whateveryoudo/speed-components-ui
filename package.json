{
  "name": "speed-components-ui",
  "version": "0.1.41",
  "description": "基于 Ant Design Vue 的组件库，封装了常用业务组件，可快速搭建应用",
  "main": "dist/index.es.js",
  "module": "dist/index.es.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.es.js"
    },
    "./dist/style.css": "./dist/style.css",
    "./hooks": {
      "import": "./src/hooks/index.ts"
    },
    "./components": {
      "import": "./src/components/index.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "npm run build:lib && npm run build:example",
    "build:lib": "cross-env BUILD_MODE=lib vite build",
    "build:example": "vite build --outDir dist-example",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "test": "vitest",
    "lint": "eslint src example --ext .ts,.tsx,.vue",
    "format": "prettier --write \"src/**/*.{ts,tsx,vue}\" \"example/**/*.{ts,tsx,vue}\""
  },
  "keywords": [
    "vue",
    "components",
    "ant-design-vue",
    "speed-components",
    "speed-components-ui",
    "hooks",
    "utils"
  ],
  "author": "",
  "license": "MIT",
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.52.11",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.6",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.0",
    "@types/highlight.js": "^10.1.0",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^20.11.0",
    "@unocss/vite": "^0.58.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "@vitejs/plugin-vue-jsx": "^4.2.0",
    "@vue/compiler-sfc": "^3.4.0",
    "@vue/language-core": "^3.0.6",
    "@vue/test-utils": "^2.4.0",
    "@vue/tsconfig": "^0.5.0",
    "cross-env": "^7.0.3",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.0",
    "eslint-plugin-vue": "^9.21.0",
    "husky": "^9.0.0",
    "less": "^4.2.0",
    "prettier": "^3.2.0",
    "semantic-release": "^25.0.3",
    "typescript": "^5.3.0",
    "unocss": "^0.58.0",
    "unplugin-dts": "1.0.0-beta.0",
    "unplugin-vue-components": "^28.7.0",
    "vite": "^5.0.0",
    "vitest": "^1.2.0",
    "vue-tsc": "^1.8.0"
  },
  "dependencies": {
    "@ant-design/icons-vue": "^7.0.0",
    "@highlightjs/vue-plugin": "^2.1.2",
    "@types/lodash-es": "^4.17.12",
    "@vueuse/core": "^13.1.0",
    "@wangeditor/editor": "^5.1.23",
    "@wangeditor/editor-for-vue": "^5.1.12",
    "ant-design-vue": "^4.1.0",
    "axios": "^0.27.2",
    "dayjs": "^1.11.7",
    "dompurify": "^3.2.6",
    "highlight.js": "^11.11.1",
    "lodash-es": "^4.17.21",
    "markdown-it": "^14.1.0",
    "speed-components-ui": "^0.1.40",
    "viewerjs": "^1.11.2",
    "vitepress": "^1.0.0",
    "vue-color": "^3.2.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/whateveryoudo/speed-components-ui.git"
  },
  "bugs": {
    "url": "https://github.com/whateveryoudo/speed-components-ui/issues"
  },
  "homepage": "https://github.com/whateveryoudo/speed-components-ui#readme",
  "packageManager": "pnpm@9.15.0+sha512.76e2379760a4328ec4415815bcd6628dee727af3779aaa4c914e3944156c4299921a89f976381ee107d41f12cfa4b66681ca9c718f0668fa0831ed4c6d8ba56c"
}
